{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["name", "slug", "version", "build"],
  "properties": {
    "name": {"type":"string","minLength":1},
    "nameJa": {"type":"string"},
    "slug": {"type":"string","pattern":"^[a-z0-9][a-z0-9-]*$"},
    "version": {"type":"string","minLength":1},
    "description": {"type":"string"},
    "descriptionJa": {"type":"string"},
    "defaultLanguage": {"enum":["auto","ja","en"]},
    "repository": {"type":"object"},
    "build": {
      "type":"object",
      "required":["output","blockRuntimeNetwork"],
      "properties": {
        "output":{"type":"string"},
        "blockRuntimeNetwork":{"type":"boolean"},
        "selfExtract":{"type":"object"},
        "sizeBudget":{"type":"object"}
      }
    }
  }
}
